# semisector — Email Configuration
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# The .env file is in .gitignore and will NEVER be pushed to GitHub.
# ─────────────────────────────────────────────────────────────────

# Your Office 365 / Outlook email address
SEMISECTOR_EMAIL_FROM=your.email@outlook.com

# Recipient email address(es) — comma-separated for multiple
SEMISECTOR_EMAIL_TO=recipient@example.com

# Your Outlook password (or App Password if 2FA is enabled)
SEMISECTOR_EMAIL_PASSWORD=your_password_here
